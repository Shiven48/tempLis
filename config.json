{
  "BS_240": {
    "protocol": "astm",
    "config": {
      "isSerial": "true",
      "isSocket": "false",
      "COM": "COM2",
      "baudrate": 9600,
      "parity": "N",
      "stopbits": 1,
      "bytesize": 8,
      "timeout": 1
    },
    "records": {
      "header": {
        "fields": [
          { "name": "record_type_id", "index": 0, "type": "constantField", "default": "H" },
          { "name": "delimeter", "index": 1, "type": "constantField", "default": "\\^&" },
          { "name": "sender_name_id", "index": 4, "type": "componentField", "component": { 
              "name": "AddressComponent",
              "fields": [
                { "name": "sender_name", "index": 0, "type": "textField" },
                { "name": "software_version", "index": 1, "type": "textField" },
                { "name": "sequence_number", "index": 2, "type": "textField" }
              ]
            }
          },
          { "name": "Processing_Id", "index": 11, "type": "setField", "values": ["PR", "QR", "CR", "RQ", "QA", "SA"] },
          { "name": "protocol_version", "index": 12, "type": "textField", "length": 10 },
          { "name": "timestamp", "index": 13, "type": "dateTimeField", "format": "%Y%m%d%H%M%S", "required": true }
        ]
      },
      "patient": {
        "fields": [
          { "name": "record_type_id", "index": 0, "type": "constantField", "default": "P" },
          { "name": "sequence_number", "index": 1, "type": "integerField", "length": 3 },
          { "name": "patient_id", "index": 3, "type": "textField", "length": 25 },
          { "name": "patient_name", "index": 5, "type": "componentField", "component": { 
              "name": "PatientNameComponent",
              "fields": [
                { "name": "last_name", "index": 1, "type": "textField", "length": 20 },
                { "name": "first_name", "index": 2, "type": "textField", "length": 20 },
                { "name": "middle_initial", "index": 3, "type": "textField", "length": 1 }
              ]
            }
          },
          { "name": "age_info", "index": 7, "type": "componentField", "component": { 
              "name": "PatientAgeComponent",
              "fields": [
                { "name": "birth_date", "index": 0, "type": "textField", "length": 8 },
                { "name": "age", "index": 1, "type": "integerField", "length": 6 },
                { "name": "age_unit", "index": 2, "type": "setField", "length": 1, "values": ["Y", "M", "W", "D", "H"], "default": "Y" }
              ]
            }
          },
          { "name": "patient_sex", "index": 8, "type": "setField", "values": ["M", "F", "U"], "length": 1 },
          { "name": "patient_address", "index": 10, "type": "textField", "length": 50 },
          { "name": "patient_diagnosis", "index": 18, "type": "textField", "length": 50 },
          { "name": "location", "index": 25, "type": "textField", "length": 10 }
        ]
      },
      "order": {
        "fields": [
          { "name": "record_type_id", "index": 0, "type": "constantField", "default": "O" },
          { "name": "sequence_number", "index": 1, "type": "integerField", "length": 3 },
          { "name": "sample_position", "index": 2, "type": "componentField", "component": { 
              "name": "SamplePositionComponent",
              "fields": [
                { "name": "sample_id", "index": 0, "type": "textField", "length": 20 }
