            }
          },
          { "name": "instrument_id", "index": 3, "type": "textField", "length": 29 },
          { "name": "assay_info", "index": 4, "type": "repeatedComponentField", "component": {
              "name": "AssayInfoComponent",
              "fields": [
                { "name": "test_code", "index": 0, "type": "textField" },
                { "name": "test_name", "index": 1, "type": "textField" }
              ]
            }
          },
          { "name": "priority", "index": 5, "type": "setField", "values": ["R", "S"] },
          { "name": "requested_at", "index": 6, "type": "textField", "length": 14 },
          { "name": "collected_at", "index": 7, "type": "textField", "length": 14 },
          { "name": "received_at", "index": 14, "type": "textField", "length": 14 },
          { "name": "specimen_type", "index": 15, "type": "setField", "values": ["serum", "urine", "CSF", "plasma", "timed", "other", "blood", "amniotic", "urethral", "saliva", "cervical", "synovial"], "length": 10 },
          { "name": "ordering_physician_info", "index": 16, "type": "componentField", "component": { 
              "name": "OrderingPhysicianComponent",
              "fields": [
                { "name": "last_name", "index": 1, "type": "textField", "length": 20 },
                { "name": "first_name", "index": 2, "type": "textField", "length": 20 }
              ]
            }
          },
          { "name": "physician_phone", "index": 17, "type": "textField", "length": 30 },
          { "name": "report_type", "index": 25, "type": "setField", "values": ["O", "Q", "F"], "length": 1 }
        ]
      },
      "result": {
        "fields": [
          { "name": "record_type_id", "index": 0, "type": "constantField", "default": "R" },
          { "name": "sequence_number", "index": 1, "type": "integerField", "length": 3 },
          { "name": "assay_info", "index": 2, "type": "componentField", "component": { 
              "name": "AssayResultComponent",
              "fields": [
                { "name": "assay_number", "index": 0, "type": "textField", "length": 12 },
                { "name": "assay_name", "index": 1, "type": "textField", "length": 20 },
                { "name": "result_type", "index": 3, "type": "setField", "values": ["I", "F"], "length": 1 }
              ]
            }
          },
          { "name": "result_value", "index": 3, "type": "componentField", "component": { 
              "name": "ResultValueComponent",
              "fields": [
                { "name": "measurement_value", "index": 0, "type": "decimalField", "length": 14 },
                { "name": "interpretation", "index": 1, "type": "textField", "length": 15 }
              ]
            }
          },
          { "name": "units", "index": 4, "type": "textField", "length": 12 },
          { "name": "reference_range", "index": 5, "type": "componentField", "component": { 
              "name": "MeasurementComponent",
              "fields": [
                { "name": "range_high", "index": 0, "type": "decimalField", "length": 12 },
                { "name": "range_low", "index": 1, "type": "decimalField", "length": 12 }
              ]
            }
          },
          { "name": "abnormal_flag", "index": 6, "type": "setField", "values": ["L", "H", "N"], "length": 1 },
          { "name": "abnormal_nature", "index": 7, "type": "textField", "length": 15 },
          { "name": "result_status", "index": 8, "type": "setField", "values": ["F"], "length": 1 },
          { "name": "completed_at", "index": 12, "type": "textField", "length": 14 },
          { "name": "instrument_info", "index": 13, "type": "componentField", "component": { 
              "name": "InstrumentComponent",
              "fields": [
                { "name": "sender_name", "index": 0, "type": "textField", "length": 16 }
              ]
            }
          }
        ]
      },
      "comment": {
        "fields": [
          { "name": "record_type_id", "index": 0, "type": "constantField", "default": "C" },
          { "name": "sequence_number", "index": 1, "type": "integerField", "length": 3 },
          { "name": "comment_text", "index": 3, "type": "textField", "length": 90 },
          { "name": "comment_type", "index": 4, "type": "setField", "values": ["G", "I"], "length": 1 }
        ]
      },
      "terminator": {
        "fields": [
          { "name": "record_type_id", "index": 0, "type": "constantField", "default": "L" },
          { "name": "sequence_number", "index": 1, "type": "integerField", "length": 3 },
          { "name": "termination_code", "index": 2, "type": "setField", "values": ["N", "I", "Q"], "length": 1 }
        ]
      }
    }
  },
