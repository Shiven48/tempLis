          { "name": "record_type_id", "index": 0, "type": "constantField", "default": "H" },
          { "name": "delimeter", "index": 1, "type": "constantField", "default": "\\^&" },
          { "name": "sender_name_id", "index": 4, "type": "componentField",
            "component": {
              "name": "AddressComponent",
              "fields": [
                { "name": "sender_name", "type": "textField" },
                { "name": "software_version", "type": "textField" },
                { "name": "sequence_number", "type": "textField" }
